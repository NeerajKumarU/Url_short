# Copy this to secret.yaml, fill in real values, and NEVER commit the real file.
# Add k8s/secret.yaml to .gitignore. In a real pipeline, generate this from
# CI/CD secrets (GitHub Actions secrets) or a vault, not by hand.
apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: devops-portfolio
type: Opaque
stringData:
  DB_USER: postgres
  DB_PASSWORD: changeme
  POSTGRES_USER: postgres       # read by the postgres container itself
  POSTGRES_PASSWORD: changeme   # must match DB_PASSWORD above
  POSTGRES_DB: urlshortener
---
apiVersion: v1
kind: Secret
metadata:
  name: django-secret
  namespace: devops-portfolio
type: Opaque
stringData:
  DJANGO_SECRET_KEY: "generate-with-django-utils-get-random-secret-key"
