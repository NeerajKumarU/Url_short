# Core Django
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=urlshortener
DB_USER=postgres
DB_PASSWORD=replace-me

# Email (console is honest and safe for local development)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=False
DJANGO_DEFAULT_FROM_EMAIL=OrbitLink <noreply@example.com>

# Analytics privacy / trusted edge metadata
ORBITLINK_TRUST_CLOUDFLARE_GEO=False
ORBITLINK_STORE_VISITOR_IPS=True

# Optional AI provider. Leave the key empty to keep AI explicitly unavailable.
ORBITLINK_AI_API_KEY=
ORBITLINK_AI_ENDPOINT=https://api.openai.com/v1/responses
ORBITLINK_AI_MODEL=gpt-4.1-mini

# Optional comma-separated destination block list
ORBITLINK_BLOCKED_DOMAINS=
